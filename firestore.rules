// Firestore security rules.
//
// This file opts the single `admin_settings/app_settings` document into
// PUBLIC READ so that unauthenticated visitors can fetch the favicon URL +
// faviconUpdatedAt timestamp used by the inline bootstrap script in
// web/index.html. That document only ever contains global branding metadata
// (favicon URL, app name, etc.) — nothing sensitive.
//
// Writes still require auth; the admin UI enforces admin role on top.
//
// If you already have custom rules elsewhere, merge the admin_settings match
// block into your existing rules instead of replacing this file wholesale.
//
// Deploy with:
//   firebase deploy --only firestore:rules
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Publicly-readable branding metadata (favicon URL, app name, etc.).
    match /admin_settings/app_settings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // AI settings (OpenAI key, model, etc.) — readable by all clients so guests
    // can generate recipes without signing in. The key is already used client-side
    // for OpenAI calls; writes remain authenticated-only.
    match /admin_settings/ai_settings {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Other admin settings (payments, SEO, etc.).
    match /admin_settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User recipes — owners can read/write their own; admins can read any recipe.
    match /recipes/{recipeId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Guest recipes awaiting signup/payment — only the owner can read/write.
    match /pending_recipes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Subscription plans — active plans are public so visitors can view pricing.
    match /subscription_plans/{planId} {
      allow read: if resource.data.isActive == true || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Everything else: authenticated users only.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
