<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: dark background with the rounded-square brand logo.
         The inset drawable keeps the logo's rounded-rect shape visible inside
         the system's circular icon mask. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_inset</item>
    </style>
</resources>
